{
  "title": "Cart – Business",
  "uid": "cart-business",
  "tags": ["prometheus-app", "business"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Carts open & unpaid (live)",
      "description": "Live count of carts waiting for payment. Drops to zero at the daily cutoff.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(cart_unpaid)",
          "legendFormat": "unpaid"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Abandon ratio (24h)",
      "description": "Share of carts created that end up abandoned unpaid at the cutoff: cart_abandoned_total increase(1d) / cart_created_total{status=\"success\"} increase(1d).",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "job:cart:abandon_ratio1d",
          "legendFormat": "abandon ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "red", "value": 0.4 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Carts created – success rate (5m)",
      "description": "Share of cart_created_total in the last 5 minutes labeled status=success.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(cart_created_total{status=\"success\"}[5m])) / sum(rate(cart_created_total[5m]))",
          "legendFormat": "success rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Carts paid (total)",
      "description": "Cumulative count since the process started -- watch the trend more than the absolute value.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(cart_paid_total)",
          "legendFormat": "paid"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Carts created rate, by status",
      "description": "job:cart_created:rate5m -- created carts per second, split success vs failure.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "job:cart_created:rate5m",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Carts abandoned per day",
      "description": "job:cart_abandoned:increase1d -- moves only at the daily cutoff, so expect a step function rather than a smooth curve.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "job:cart_abandoned:increase1d",
          "legendFormat": "abandoned (1d increase)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Carts open & unpaid over time",
      "description": "Raw cart_unpaid gauge -- should saw-tooth up during the day and reset at the cutoff.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(cart_unpaid)",
          "legendFormat": "unpaid"
        }
      ]
    }
  ]
}
